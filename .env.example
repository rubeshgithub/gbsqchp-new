# MongoDB connection string (local dev or your server's MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/gbsqchp

# Long random string used to sign auth cookies and encrypt API keys. Change it in every environment.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap, JSON-LD and live preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
