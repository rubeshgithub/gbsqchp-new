# MongoDB connection string (local dev or your server's MongoDB)
DATABASE_URL=mongodb://127.0.0.1:27017/gbsqchp

# Long random string used to sign auth cookies and encrypt API keys. Change it in every environment.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public origin of the site (no trailing slash). Used for canonical URLs, sitemap, JSON-LD and live preview.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---- Contact form email (optional; without SMTP_HOST messages are only saved in the admin) ----
# Any SMTP mailbox works. Google Workspace/Gmail: smtp.gmail.com, port 465 or 587, an App Password.
# Microsoft 365: smtp.office365.com, port 587. Zoho: smtp.zoho.com, port 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Address the email is sent from (usually the same as SMTP_USER)
SMTP_FROM=
SMTP_FROM_NAME=Primary Source Verification Guide
# Where contact-form enquiries are delivered
CONTACT_TO_EMAIL=rubesh@insteadglobal.com
